{
  "manifest_version": 3,
  "name": "PageMind",
  "version": "0.1.0",
  "description": "Summarize any web page in one click. Naked MVP - all processing happens locally in your browser.",
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PageMind"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/*.wasm", "vendor/*.mjs", "vendor/*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
